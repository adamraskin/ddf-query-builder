    "test:ddf-live": "vitest run --config vitest.ddf-live.config.ts"
  },
  "dependencies": {
    "@ddf/shared": "*",
    "@langchain/core": "0.3.80",
    "@langchain/langgraph": "0.2.74",
    "@langchain/openai": "0.3.17",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "morgan": "1.11.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/morgan": "1.9.10",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
