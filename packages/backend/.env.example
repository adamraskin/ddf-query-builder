# Port the Express server listens on
PORT=4000

# Origin(s) allowed to call this API from the browser
CORS_ORIGIN=http://localhost:3000

# LM Studio exposes an OpenAI-compatible server, typically at this address
# once you've started a model and enabled the local server in LM Studio.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM Studio doesn't require a real key, but the OpenAI SDK requires the field to be set.
LM_STUDIO_API_KEY=lm-studio
# Must match the model identifier shown in LM Studio's "Local Server" tab.
LM_STUDIO_MODEL=local-model

# Base DDF/RESO OData endpoint the translator builds URLs against.
DDF_BASE_URL=https://ddfapi.realtor.ca/odata/v1/Property

LOG_LEVEL=dev
